{
  "schemaVersion": 1,
  "id": "foxmodelloader",
  "version": "${version}",
  "name": "Fox Model Loader: Revival",
  "description": "Fox Model Loader: Revival - Custom player model system for Minecraft.",
  "authors": ["Micaftic"],
  "contact": {
    "homepage": "https://github.com/sdf123098/Fox-Model-Loader",
    "sources": "https://github.com/sdf123098/Fox-Model-Loader",
    "issues": "https://github.com/sdf123098/Fox-Model-Loader/issues"
  },
  "license": "MIT",
  "icon": "foxmodelloader.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.micaftic.morpher.fabric.YesSteveModelFabric"
    ],
    "client": [
      "com.micaftic.morpher.fabric.client.YesSteveModelFabricClient"
    ],
    "modmenu": [
      "com.micaftic.morpher.fabric.compat.ModMenuConfigScreenProvider"
    ],
    "cardinal-components-entity": [
      "com.micaftic.morpher.fabric.YsmComponents"
    ]
  },
  "mixins": [
    "foxmodelloader.mixins.json",
    "foxmodelloader_fabric.mixins.json"
  ],
  "accessWidener": "foxmodelloader.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "architectury": ">=13.0.8",
    "forgeconfigapiport": ">=21.1.0"
  },
  "suggests": {
    "modmenu": "*",
    "touhou_little_maid": "*"
  },
  "custom": {
    "cardinal-components": [
      "foxmodelloader:star_models",
      "foxmodelloader:auth_models",
      "foxmodelloader:model_info",
      "foxmodelloader:projectile_model",
      "foxmodelloader:vehicle_model"
    ]
  }
}
